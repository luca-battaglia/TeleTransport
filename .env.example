# Copy to .env and fill in what you need. .env is git-ignored.

# CLI: SerpApi key used by `python -m cli flights`.
SERPAPI_KEY=

# API server: optional shared key for visitors who have not entered their own.
# Leave empty to require a personal key for every flight search.
SERPAPI_DEMO_KEY=
# SerpApi calls the demo may spend per UTC day, across all visitors. The free
# plan allows 250 searches a month; 8 a day stays under it.
DEMO_DAILY_CALLS=8
# Demo searches one visitor may run per day.
DEMO_CLIENT_DAILY_SEARCHES=2

# API server: searches one visitor may run per hour, trains and flights together.
RATE_LIMIT_SEARCHES_PER_HOUR=40
# API server: train searches running at once; each one drives a headless browser.
MAX_CONCURRENT_TRAIN_SEARCHES=2
# API server: shared with the web app's proxy, which sets the same variable and
# uses it to vouch for each visitor's address. Generate one with: openssl rand -hex 32
BACKEND_PROXY_SECRET=

# Optional: config file other than ./travel_ranker.toml.
# TRAVEL_RANKER_CONFIG=/path/to/travel_ranker.toml
# Optional: where upstream responses and rate-limit counters are stored (default ./.cache).
# TELETRANSPORT_CACHE_DIR=/var/cache/teletransport
